<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center_vertical" android:paddingStart="8dp" android:paddingEnd="8dp" android:paddingTop="6dp" android:paddingBottom="6dp" android:background="@drawable/pulse_widget_bg">
 <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical" android:orientation="horizontal">
  <ImageView android:id="@+id/widget_art" android:layout_width="36dp" android:layout_height="36dp" android:layout_marginEnd="6dp" android:background="@drawable/pulse_widget_art" android:src="@android:drawable/ic_media_play" android:scaleType="centerCrop" android:contentDescription="Обложка композиции"/>
  <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
   <TextView android:id="@+id/widget_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:singleLine="true" android:ellipsize="end" android:text="Pulse" android:textColor="#FFFFFFFF" android:textSize="15sp" android:textStyle="bold"/>
   <TextView android:id="@+id/widget_artist" android:layout_width="match_parent" android:layout_height="wrap_content" android:singleLine="true" android:ellipsize="end" android:textColor="#FFC4BEDB" android:textSize="11sp"/>
  </LinearLayout>
  <ImageView android:id="@+id/widget_prev" android:layout_width="36dp" android:layout_height="48dp" android:padding="10dp" android:src="@android:drawable/ic_media_previous" android:tint="#FFFFFFFF" android:contentDescription="Предыдущая песня" android:scaleType="fitCenter" />
  <ImageView android:id="@+id/widget_play" android:layout_width="48dp" android:layout_height="48dp" android:padding="11dp" android:src="@android:drawable/ic_media_play" android:tint="#FF171126" android:background="@drawable/pulse_widget_chip_active" android:contentDescription="Воспроизвести"/>
  <ImageView android:id="@+id/widget_next" android:layout_width="36dp" android:layout_height="48dp" android:padding="10dp" android:src="@android:drawable/ic_media_next" android:tint="#FFFFFFFF" android:contentDescription="Следующая песня" android:scaleType="fitCenter" />
 </LinearLayout>
 <LinearLayout android:id="@+id/widget_effects" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="4dp" android:orientation="horizontal">
  <TextView android:id="@+id/widget_fast" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:gravity="center" android:layout_marginEnd="3dp" android:background="@drawable/pulse_widget_chip" android:text="Sped Up" android:textColor="#FFE9E4FF" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" /><TextView android:id="@+id/widget_night" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:gravity="center" android:layout_marginEnd="3dp" android:background="@drawable/pulse_widget_chip" android:text="Nightcore" android:textColor="#FFE9E4FF" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" /><TextView android:id="@+id/widget_edit" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:gravity="center" android:layout_marginEnd="3dp" android:background="@drawable/pulse_widget_chip" android:text="Редактор" android:textColor="#FFE9E4FF" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" />
 </LinearLayout>
 <LinearLayout android:id="@+id/widget_detail" android:layout_width="match_parent" android:layout_height="32dp" android:gravity="center_vertical" android:orientation="horizontal">
 <TextView android:id="@+id/widget_mode" android:layout_width="0dp" android:layout_weight="1" android:layout_height="20dp" android:gravity="center_vertical" android:singleLine="true" android:ellipsize="end" android:textColor="#FFB9A3FF" android:textSize="11sp" android:textStyle="bold"/>
 <TextView android:id="@+id/widget_search" android:layout_width="72dp" android:layout_height="32dp" android:gravity="center" android:text="Поиск" android:textColor="#FFE9E4FF" android:textSize="12sp" android:background="@drawable/pulse_widget_chip"/>
 </LinearLayout>
 <LinearLayout android:id="@+id/widget_studio" android:layout_width="match_parent" android:layout_height="44dp" android:orientation="horizontal">
  <TextView android:id="@+id/widget_slow" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:gravity="center" android:layout_marginEnd="3dp" android:background="@drawable/pulse_widget_chip" android:text="Slow" android:textColor="#FFE9E4FF" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" /><TextView android:id="@+id/widget_reset" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:gravity="center" android:layout_marginEnd="3dp" android:background="@drawable/pulse_widget_chip" android:text="Сброс" android:textColor="#FFE9E4FF" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" /><TextView android:id="@+id/widget_save" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:gravity="center" android:layout_marginEnd="3dp" android:background="@drawable/pulse_widget_chip" android:text="Сохр." android:textColor="#FFE9E4FF" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" /><TextView android:id="@+id/widget_genres" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:gravity="center" android:layout_marginEnd="3dp" android:background="@drawable/pulse_widget_chip" android:text="Жанры" android:textColor="#FFE9E4FF" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" /><TextView android:id="@+id/widget_lyrics" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:gravity="center" android:layout_marginEnd="3dp" android:background="@drawable/pulse_widget_chip" android:text="Текст" android:textColor="#FFE9E4FF" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" />
 </LinearLayout>
</LinearLayout>

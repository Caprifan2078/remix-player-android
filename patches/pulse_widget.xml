<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center_vertical" android:paddingStart="8dp" android:paddingEnd="8dp" android:paddingTop="6dp" android:paddingBottom="6dp" android:background="@drawable/pulse_widget_bg">
 <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical" android:orientation="horizontal">
  <ImageView android:id="@+id/widget_art" android:layout_width="36dp" android:layout_height="36dp" android:layout_marginEnd="6dp" android:background="@drawable/pulse_widget_art" android:src="@android:drawable/ic_media_play" android:scaleType="centerCrop" android:contentDescription="Обложка композиции"/>
  <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
   <TextView android:id="@+id/widget_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:singleLine="true" android:ellipsize="end" android:text="Pulse" android:textColor="#FFFFFFFF" android:textSize="15sp" android:textStyle="bold"/>
   <TextView android:id="@+id/widget_artist" android:layout_width="match_parent" android:layout_height="wrap_content" android:singleLine="true" android:ellipsize="end" android:textColor="#FFC4BEDB" android:textSize="11sp"/>
  </LinearLayout>
  <ImageView android:id="@+id/widget_prev" android:layout_width="36dp" android:layout_height="48dp" android:padding="10dp" android:src="@android:drawable/ic_media_previous" android:contentDescription="Предыдущая песня" android:scaleType="fitCenter" />
  <ImageView android:id="@+id/widget_play" android:layout_width="48dp" android:layout_height="48dp" android:padding="11dp" android:src="@android:drawable/ic_media_play" android:background="@drawable/pulse_widget_chip" android:contentDescription="Воспроизвести"/>
  <ImageView android:id="@+id/widget_next" android:layout_width="36dp" android:layout_height="48dp" android:padding="10dp" android:src="@android:drawable/ic_media_next" android:contentDescription="Следующая песня" android:scaleType="fitCenter" />
 </LinearLayout>
 <LinearLayout android:id="@+id/widget_detail" android:layout_width="match_parent" android:layout_height="44dp" android:orientation="horizontal">
 <TextView android:id="@+id/widget_back10" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:gravity="center" android:layout_marginEnd="3dp" android:background="@drawable/pulse_widget_chip" android:text="−10с" android:contentDescription="Назад 10 секунд" android:textColor="#FFE9E4FF" android:textSize="12sp" android:maxLines="1" android:ellipsize="end"/><TextView android:id="@+id/widget_quarter" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:gravity="center" android:layout_marginEnd="3dp" android:background="@drawable/pulse_widget_chip" android:text="25%" android:contentDescription="Перейти к четверти трека" android:textColor="#FFE9E4FF" android:textSize="12sp" android:maxLines="1" android:ellipsize="end"/><TextView android:id="@+id/widget_middle" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:gravity="center" android:layout_marginEnd="3dp" android:background="@drawable/pulse_widget_chip" android:text="50%" android:contentDescription="Перейти к середине трека" android:textColor="#FFE9E4FF" android:textSize="12sp" android:maxLines="1" android:ellipsize="end"/><TextView android:id="@+id/widget_threequarters" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:gravity="center" android:layout_marginEnd="3dp" android:background="@drawable/pulse_widget_chip" android:text="75%" android:contentDescription="Перейти к трём четвертям трека" android:textColor="#FFE9E4FF" android:textSize="12sp" android:maxLines="1" android:ellipsize="end"/><TextView android:id="@+id/widget_forward10" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:gravity="center" android:layout_marginEnd="3dp" android:background="@drawable/pulse_widget_chip" android:text="+10с" android:contentDescription="Вперёд 10 секунд" android:textColor="#FFE9E4FF" android:textSize="12sp" android:maxLines="1" android:ellipsize="end"/>
 </LinearLayout>
 <LinearLayout android:id="@+id/widget_effects" android:layout_width="match_parent" android:layout_height="44dp" android:orientation="horizontal">
 <TextView android:id="@+id/widget_speed80" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:gravity="center" android:layout_marginEnd="3dp" android:background="@drawable/pulse_widget_chip" android:text="0,8×" android:contentDescription="0,8×" android:textColor="#FFE9E4FF" android:textSize="12sp" android:maxLines="1" android:ellipsize="end"/><TextView android:id="@+id/widget_speed100" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:gravity="center" android:layout_marginEnd="3dp" android:background="@drawable/pulse_widget_chip" android:text="1×" android:contentDescription="1×" android:textColor="#FFE9E4FF" android:textSize="12sp" android:maxLines="1" android:ellipsize="end"/><TextView android:id="@+id/widget_speed125" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:gravity="center" android:layout_marginEnd="3dp" android:background="@drawable/pulse_widget_chip" android:text="1,25×" android:contentDescription="1,25×" android:textColor="#FFE9E4FF" android:textSize="12sp" android:maxLines="1" android:ellipsize="end"/><TextView android:id="@+id/widget_speed150" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:gravity="center" android:layout_marginEnd="3dp" android:background="@drawable/pulse_widget_chip" android:text="1,5×" android:contentDescription="1,5×" android:textColor="#FFE9E4FF" android:textSize="12sp" android:maxLines="1" android:ellipsize="end"/>
 </LinearLayout>
 <LinearLayout android:id="@+id/widget_studio" android:layout_width="match_parent" android:layout_height="44dp" android:orientation="horizontal">
 <TextView android:id="@+id/widget_fast" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:gravity="center" android:layout_marginEnd="3dp" android:background="@drawable/pulse_widget_chip" android:text="Sped Up" android:contentDescription="Sped Up" android:textColor="#FFE9E4FF" android:textSize="12sp" android:maxLines="1" android:ellipsize="end"/><TextView android:id="@+id/widget_night" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:gravity="center" android:layout_marginEnd="3dp" android:background="@drawable/pulse_widget_chip" android:text="Nightcore" android:contentDescription="Nightcore" android:textColor="#FFE9E4FF" android:textSize="12sp" android:maxLines="1" android:ellipsize="end"/><TextView android:id="@+id/widget_slow" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:gravity="center" android:layout_marginEnd="3dp" android:background="@drawable/pulse_widget_chip" android:text="Slow" android:contentDescription="Slow" android:textColor="#FFE9E4FF" android:textSize="12sp" android:maxLines="1" android:ellipsize="end"/><TextView android:id="@+id/widget_edit" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:gravity="center" android:layout_marginEnd="3dp" android:background="@drawable/pulse_widget_chip" android:text="Правка" android:contentDescription="Правка" android:textColor="#FFE9E4FF" android:textSize="12sp" android:maxLines="1" android:ellipsize="end"/><TextView android:id="@+id/widget_queue" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:gravity="center" android:layout_marginEnd="3dp" android:background="@drawable/pulse_widget_chip" android:text="Очередь" android:contentDescription="Очередь" android:textColor="#FFE9E4FF" android:textSize="12sp" android:maxLines="1" android:ellipsize="end"/>
 </LinearLayout>
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal" android:gravity="center_vertical" android:padding="8dp" android:background="@drawable/pulse_widget_bg">
 <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
  <TextView android:id="@+id/widget_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:singleLine="true" android:ellipsize="end" android:text="Pulse" android:textColor="#FFFFFFFF" android:textSize="15sp" android:textStyle="bold"/>
  <TextView android:id="@+id/widget_artist" android:layout_width="match_parent" android:layout_height="wrap_content" android:singleLine="true" android:ellipsize="end" android:textColor="#FFBABACA" android:textSize="12sp"/>
 </LinearLayout>
 <TextView android:id="@+id/widget_prev" android:layout_width="40dp" android:layout_height="48dp" android:gravity="center" android:text="◀" android:textColor="#FFFFFFFF" android:textSize="18sp" android:contentDescription="Предыдущая песня"/>
 <TextView android:id="@+id/widget_play" android:layout_width="48dp" android:layout_height="48dp" android:gravity="center" android:text="▶" android:textColor="#FFFFFFFF" android:textSize="22sp" android:contentDescription="Воспроизвести"/>
 <TextView android:id="@+id/widget_next" android:layout_width="40dp" android:layout_height="48dp" android:gravity="center" android:text="▶|" android:textColor="#FFFFFFFF" android:textSize="18sp" android:contentDescription="Следующая песня"/>
</LinearLayout>
